generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER & ROLE
// ==========================================

enum Role {
  ADMIN
  OPERATOR
  PEGAWAI
  BENDAHARA
  PPK
}

// Akun autentikasi aplikasi
model User {
  id           String @id @default(cuid())
  username     String @unique
  email        String @unique
  passwordHash String

  role     Role    @default(PEGAWAI)
  isActive Boolean @default(true)

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Relasi master pegawai
  pegawai Pegawai?

  // Relasi operasional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MASTER PEGAWAI
// ==========================================

model Pegawai {
  id String @id @default(cuid())

  // Identitas pegawai
  nipLama String @unique
  nipBaru String @unique
  nik     String @unique
  nama    String

  // Informasi kepegawaian
  jabatan    String
  golongan   String
  pangkat    String
  pendidikan String?

  // Informasi kontak
  email String?
  noHp  String?

  // Informasi perpajakan dan rekening
  npwp     String?
  rekening String?
  bank     String?

  // Dokumen pegawai
  linkSkJabatan String?
  linkSkPangkat String?
  foto          String?

  // Status keaktifan
  aktif Boolean @default(true)

  // Akun login bersifat opsional
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Relasi operasional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nama])
}
